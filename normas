            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" id="modal-ask-btn">Preguntar sobre este artículo al Asistente</button>
            </div>
        </div>
    </div>

    <!-- ASISTENTE VIRTUAL: "UNESITO" (Chat Flotante Interactivo) -->
    <div class="assistant-container" id="assistant-container">
        <!-- Globo de diálogo inicial del avatar (se oculta tras interactuar) -->
        <div class="avatar-bubble" id="avatar-bubble">
            <div class="bubble-text">¡Hola! Soy <strong>Unesito</strong>. Pregúntame sobre el reglamento de convivencia de la UNES. 👮‍♂️👋</div>
            <div class="bubble-arrow"></div>
        </div>

        <!-- Botón del Avatar Flotante -->
        <button class="avatar-trigger-btn" id="avatar-trigger" aria-label="Abrir asistente de chat">
            <!-- SVG Animado de Unesito (Mascota robot/cadete interactivo) -->
            <svg viewBox="0 0 100 100" class="unesito-svg">
                <!-- Sombra del personaje -->
                <ellipse cx="50" cy="88" rx="25" ry="5" fill="rgba(0,0,0,0.15)" />
                
                <!-- Cuerpo (Cuello y Hombros con uniforme azul) -->
                <path d="M30 75 C30 65, 70 65, 70 75 L65 85 L35 85 Z" fill="#0C2340" />
                <path d="M45 70 L50 78 L55 70 Z" fill="#FFD700" /> <!-- Corbata/Detalle cuello -->
                <path d="M48 70 L50 73 L52 70 Z" fill="#FFF" />
                
                <!-- Cabeza (Robot/Casco futurista amigable) -->
                <rect x="28" y="32" width="44" height="38" rx="18" fill="url(#head-grad)" stroke="#0C2340" stroke-width="2"/>
                
                <!-- Gorra de Cadete / Visera (UNES) -->
                <path d="M24 34 C30 20, 70 20, 76 34 Z" fill="#0C2340" /> <!-- Base de gorra -->
                <path d="M22 33 C26 31, 74 31, 78 33 L80 37 C80 37, 50 34, 20 37 Z" fill="#111" /> <!-- Visera -->
                <circle cx="50" cy="27" r="5" fill="#FFD700" /> <!-- Escudo dorado gorra -->
                <path d="M48 27 L50 25 L52 27 L50 29 Z" fill="#0C2340" />
                
                <!-- Audífonos / Auriculares laterales (Asistente tecnológico) -->
                <rect x="23" y="42" width="6" height="15" rx="3" fill="#FFD700" />
                <rect x="71" y="42" width="6" height="15" rx="3" fill="#FFD700" />
                <path d="M26 42 C26 28, 74 28, 74 42" fill="none" stroke="#FFD700" stroke-width="2" stroke-dasharray="2,2" />
                
                <!-- Pantalla Visor de Ojos -->
                <rect x="34" y="42" width="32" height="16" rx="8" fill="#121824" />
                
                <!-- Ojos Digitales (Círculos brillantes con animación de parpadeo por CSS) -->
                <g class="avatar-eyes">
                    <ellipse cx="43" cy="50" rx="4" ry="4" fill="#00E5FF" class="eye-left" />
                    <ellipse cx="57" cy="50" rx="4" ry="4" fill="#00E5FF" class="eye-right" />
                </g>
                
                <!-- Boca Digital (Línea que cambia con JS para gestos) -->
                <path d="M46 54 Q50 56 54 54" fill="none" stroke="#00E5FF" stroke-width="2" stroke-linecap="round" id="avatar-mouth" />

                <!-- Luces de Estado de la Cabeza (Antena lateral) -->
                <path d="M74 45 L80 43" stroke="#FFD700" stroke-width="2" />
                <circle cx="81" cy="42" r="2.5" fill="#00E5FF" class="antenna-light" />

                <!-- Gradientes -->
                <defs>
                    <linearGradient id="head-grad" x1="28" y1="32" x2="72" y2="70" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#FFFFFF"/>
                        <stop offset="0.7" stop-color="#E1E8F0"/>
                        <stop offset="1" stop-color="#C2D1E0"/>
                    </linearGradient>
                </defs>
            </svg>
            <!-- Badge indicador cuando hay mensaje pendiente -->
            <span class="notification-badge" id="notif-badge">1</span>
        </button>

        <!-- Ventana del Chat del Asistente (Inicialmente oculta) -->
        <div class="chat-widget" id="chat-widget" style="display: none;">
            <!-- Cabecera del Chat -->
            <div class="chat-header">
                <div class="chat-avatar-mini">
                    <svg viewBox="0 0 100 100" width="32" height="32">
                        <circle cx="50" cy="50" r="45" fill="#0C2340"/>
                        <!-- Mini versión del casco de Unesito -->
                        <rect x="32" y="36" width="36" height="32" rx="10" fill="#E1E8F0" />
                        <path d="M28 36 C35 25, 65 25, 72 36 Z" fill="#0C2340" />
                        <rect x="38" y="44" width="24" height="12" rx="6" fill="#121824" />
                        <circle cx="44" cy="50" r="2.5" fill="#00E5FF" />
                        <circle cx="56" cy="50" r="2.5" fill="#00E5FF" />
                        <path d="M47 52 Q50 54 53 52" fill="none" stroke="#00E5FF" stroke-width="1.5" />
                    </svg>
                </div>
                <div class="chat-title-info">
                    <h4>Asistente UNES</h4>
                    <span class="online-indicator">
                        <span class="dot"></span> En línea (Respuesta al instante)
                    </span>
                </div>
                <button class="chat-close-btn" id="close-chat" aria-label="Cerrar chat">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Cuerpo del Chat: Mensajes -->
            <div class="chat-messages-container" id="chat-messages">
                <!-- Mensaje de bienvenida inicial -->
                <div class="message assistant">
                    <div class="message-bubble">
                        Hola, soy <strong>Unesito</strong>, tu asistente para las Normas de Convivencia de la UNES. 👮‍♂️
                        <br><br>
                        Puedo responder tus dudas sobre asistencia, uniformes, sanciones y comportamiento. ¿En qué te puedo orientar hoy?
                    </div>
                    <span class="message-time" id="welcome-time">10:00 AM</span>
                </div>

                <!-- Contenedor para sugerencias rápidas -->
                <div class="chat-suggestions" id="chat-suggestions">
                    <p class="suggestion-title">Preguntas frecuentes:</p>
                    <div class="suggestions-list">
                        <button class="suggest-btn" data-query="¿Qué son las faltas leves?">⚠️ Faltas leves</button>
                        <button class="suggest-btn" data-query="¿Qué pasa si falto a clases sin justificación?">📅 Faltas de asistencia</button>
                        <button class="suggest-btn" data-query="¿Cuáles son mis derechos como estudiante?">🛡️ Mis derechos</button>
                        <button class="suggest-btn" data-query="¿Cuál es la norma sobre el uniforme?">👔 Uso del uniforme</button>
                        <button class="suggest-btn" data-query="¿Qué es la disciplina voluntaria?">🤝 Disciplina voluntaria</button>
                    </div>
                </div>
            </div>

            <!-- Indicador de escritura "Unesito está pensando..." -->
            <div class="typing-indicator" id="typing-indicator" style="display: none;">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span>Unesito está consultando las normas...</span>
            </div>

            <!-- Formulario de Entrada de Mensajes -->
            <form class="chat-input-area" id="chat-form">
                <input type="text" id="chat-input" placeholder="Escribe tu pregunta sobre las normas aquí..." autocomplete="off" required>
                <button type="submit" class="send-btn" id="send-message-btn" aria-label="Enviar mensaje">
                    <span class="material-symbols-outlined">send</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Audio para notificaciones del chat (sutil y amigable) -->
    <audio id="notif-sound" src="https://assets.mixkit.co/active_storage/sfx/2357/2357-84.wav" preload="auto"></audio>

    <script src="app.js"></script>
</body>
</html>

{
  "name": "unes-normas-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}

/* Estilos Globales y Diseño del Sistema de Normas de Convivencia UNES */

:root {
    --primary: #0C2340;          /* Azul Oscuro Institucional UNES */
    --primary-light: #1A365D;    /* Azul medio */
    --primary-glow: rgba(12, 35, 64, 0.08);
    --secondary: #FFD700;        /* Dorado/Amarillo UNES */
    --secondary-hover: #E5A900;  /* Dorado oscuro */
    --accent-teal: #00E5FF;      /* Cyan brillante (para la interfaz del robot) */
    --bg-light: #F4F7FB;         /* Fondo claro y limpio */
    --card-bg: rgba(255, 255, 255, 0.85); /* Fondo tarjetas con glassmorphism */
    --text-main: #2D3748;        /* Texto principal */
    --text-muted: #718096;       /* Texto atenuado */
    --border-color: rgba(226, 232, 240, 0.8);
    --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
    --shadow-md: 0 10px 20px rgba(12, 35, 64, 0.06);
    --shadow-lg: 0 20px 40px rgba(12, 35, 64, 0.12);
    --border-radius-sm: 8px;
    --border-radius-md: 16px;
    --border-radius-lg: 24px;
    --transition-fast: 0.2s ease;
    --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Reset de estilos */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-light);
    color: var(--text-main);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    line-height: 1.5;
}

/* Gradientes decorativos de fondo flotantes */
.bg-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    z-index: -1;
    opacity: 0.45;
    pointer-events: none;
}

.bg-glow-1 {
    top: -150px;
    left: -150px;
    background: radial-gradient(circle, rgba(0, 51, 102, 0.25) 0%, rgba(244, 247, 251, 0) 70%);
}

.bg-glow-2 {
    bottom: -150px;
    right: -150px;
    background: radial-gradient(circle, rgba(255, 215, 0, 0.12) 0%, rgba(244, 247, 251, 0) 70%);
}

/* Contenedor Principal */
.app-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 20px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* HEADER */
.main-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 24px;
}

@media(min-width: 768px) {
    .main-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
}

.logo-area {
    display: flex;
    align-items: center;
    gap: 16px;
}

.logo-shield {
    filter: drop-shadow(0 4px 6px rgba(12, 35, 64, 0.15));
    display: flex;
    align-items: center;
}

.logo-unes-img {
    height: 52px;
    width: auto;
    object-fit: contain;
}

.logo-text h1 {
    font-family: 'Outfit', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    letter-spacing: 0.5px;
}

.logo-text p {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    margin-top: 4px;
}

/* Buscador */
.search-filter-bar {
    width: 100%;
    max-width: 480px;
}

.search-box {
    position: relative;
    width: 100%;
}

.search-box input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    font-size: 15px;
    font-family: inherit;
    background: var(--card-bg);
    border: 1.5px solid var(--border-color);
    border-radius: var(--border-radius-md);
    color: var(--text-main);
    box-shadow: var(--shadow-sm);
    transition: var(--transition-normal);
    backdrop-filter: blur(10px);
}

.search-box input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(12, 35, 64, 0.08);
}

.search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 22px;
    pointer-events: none;
}

.clear-btn {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 50%;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
}

.clear-btn:hover {
    background-color: rgba(0,0,0,0.05);
    color: var(--text-main);
}

/* Categorías Tabs */
.category-tabs-container {
    margin-bottom: 30px;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -webkit-overflow-scrolling: touch; /* Desplazamiento táctil suave en iOS/Android */
}

.category-tabs-container::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
}

.category-tabs {
    display: flex;
    gap: 10px;
    padding: 4px;
    background: rgba(226, 232, 240, 0.4);
    border-radius: var(--border-radius-md);
    width: max-content;
}

@media(min-width: 768px) {
    .category-tabs {
        width: auto;
    }
}

.tab-btn {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    background: none;
    border: none;
    border-radius: calc(var(--border-radius-md) - 4px);
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition-normal);
    white-space: nowrap;
}

.tab-btn:hover {
    color: var(--primary);
}

.tab-btn.active {
    background: #FFF;
    color: var(--primary);
    box-shadow: 0 4px 10px rgba(0,0,0,0.04);
}

/* CONTENIDO PRINCIPAL: GRILLA DE ARTÍCULOS */
.main-content {
    flex-grow: 1;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.section-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 22px;
    color: var(--primary);
}

.badge {
    background-color: var(--primary-light);
    color: #FFF;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 50px;
}

.articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 40px;
}

@media(min-width: 640px) {
    .articles-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(min-width: 1024px) {
    .articles-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

/* Tarjeta de Artículo */
.article-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition-normal);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(8px);
    position: relative;
    overflow: hidden;
}

.article-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background-color: var(--text-muted);
}

.article-card.cat-principios::before {
    background-color: #4299E1; /* Azul */
}

.article-card.cat-derechos-deberes::before {
    background-color: #48BB78; /* Verde */
}

.article-card.cat-disciplina::before {
    background-color: #F56565; /* Rojo */
}

.article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(12, 35, 64, 0.15);
}

.card-top {
    margin-bottom: 16px;
}

.card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.category-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
}

.cat-principios .category-tag { color: #2B6CB0; }
.cat-derechos-deberes .category-tag { color: #2F855A; }
.cat-disciplina .category-tag { color: #C53030; }

.article-icon {
    font-size: 20px;
    color: var(--text-muted);
}

.card-top h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 10px;
}

.card-top p {
    font-size: 14px;
    color: var(--text-main);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.6;
}

.card-bottom {
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.btn-link {
    background: none;
    border: none;
    color: var(--primary-light);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 0;
    transition: var(--transition-fast);
}

.btn-link:hover {
    color: var(--secondary-hover);
}

.btn-link span {
    font-size: 16px;
    transition: var(--transition-fast);
}

.btn-link:hover span {
    transform: translateX(3px);
}

/* Estado Vacío de Búsqueda */
.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    background: var(--card-bg);
    border: 1.5px dashed var(--border-color);
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
}

.empty-state span {
    font-size: 56px;
    color: var(--text-muted);
    margin-bottom: 16px;
}

.empty-state h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 20px;
    color: var(--primary);
    margin-bottom: 8px;
}

.empty-state p {
    color: var(--text-muted);
    font-size: 14px;
    max-width: 420px;
    margin: 0 auto 20px;
}

.loading-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px;
}

.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(12, 35, 64, 0.1);
    border-top: 4px solid var(--primary);
    border-radius: 50%;
    margin: 0 auto 16px;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* MODAL DETALLADO */
.modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(12, 35, 64, 0.4);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    animation: fadeIn 0.25s forwards;
}

.modal-card {
    background: #FFF;
    border-radius: var(--border-radius-md);
    width: 100%;
    max-width: 640px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.25);
    overflow: hidden;
    transform: scale(0.95);
    animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes fadeIn {
    to { opacity: 1; }
}

@keyframes scaleIn {
    to { transform: scale(1); }
}

.modal-header {
    background-color: var(--primary);
    color: #FFF;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.modal-title-area h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 20px;
    font-weight: 700;
    margin-top: 4px;
}

.modal-category-tag {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    background: rgba(255,255,255,0.15);
    color: var(--secondary);
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
}

.modal-close-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    transition: var(--transition-fast);
    padding: 4px;
    border-radius: 50%;
}

.modal-close-btn:hover {
    color: #FFF;
    background: rgba(255,255,255,0.1);
}

.modal-body {
    padding: 24px;
    max-height: 60vh;
    overflow-y: auto;
}

.modal-content-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-main);
    white-space: pre-line;
}

.modal-keywords-box {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid #E2E8F0;
}

.modal-keywords-box strong {
    font-size: 13px;
    color: var(--text-main);
    display: block;
    margin-bottom: 8px;
}

.keyword-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.keyword-tag {
    font-size: 11px;
    background: #E2E8F0;
    color: var(--text-main);
    padding: 4px 10px;
    border-radius: 50px;
    font-weight: 500;
}

.modal-footer {
    padding: 16px 24px;
    background: #F7FAFC;
    border-top: 1px solid #E2E8F0;
    display: flex;
    justify-content: flex-end;
}

.btn {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    border: none;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: var(--transition-normal);
}

.btn-primary {
    background: var(--primary);
    color: #FFF;
}

.btn-primary:hover {
    background: var(--primary-light);
    box-shadow: 0 4px 12px rgba(12, 35, 64, 0.18);
}

/* FOOTER */
.main-footer {
    margin-top: auto;
    padding-top: 40px;
    padding-bottom: 16px;
    text-align: center;
    border-top: 1px solid var(--border-color);
    font-size: 13px;
    color: var(--text-muted);
}

.footer-credit {
    margin-top: 6px;
    font-size: 13px;
    color: var(--primary-light);
}

.footer-links {
    margin-top: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.footer-links a {
    color: var(--primary-light);
    text-decoration: none;
    font-weight: 600;
}

.footer-links a:hover {
    color: var(--secondary-hover);
    text-decoration: underline;
}

.separator {
    color: #CBD5E0;
}

/* ========================================== */
/* ASISTENTE VIRTUAL E INTERFAZ DE CHAT       */
/* ========================================== */

.assistant-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

/* Globo de bienvenida flotante */
.avatar-bubble {
    position: absolute;
    bottom: 95px;
    right: 10px;
    width: 250px;
    background: #FFF;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 14px 16px;
    box-shadow: var(--shadow-lg);
    z-index: 10;
    animation: bounceBubble 1s ease-in-out infinite alternate, popIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    transform-origin: bottom right;
}

@keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}

@keyframes bounceBubble {
    0% { transform: translateY(0); }
    100% { transform: translateY(-4px); }
}

.bubble-text {
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.4;
}

.bubble-arrow {
    position: absolute;
    bottom: -8px;
    right: 32px;
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid #FFF;
}

.bubble-arrow::after {
    content: '';
    position: absolute;
    bottom: 1px;
    right: -8px;
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid var(--border-color);
    z-index: -1;
}

/* Botón de Activación del Avatar */
.avatar-trigger-btn {
    width: 82px;
    height: 82px;
    border-radius: 50%;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    transition: var(--transition-normal);
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-trigger-btn:hover {
    transform: scale(1.08) rotate(3deg);
}

.avatar-trigger-btn:active {
    transform: scale(0.95);
}

/* Animaciones del Personaje SVG de Unesito */
.unesito-svg {
    width: 100%;
    height: 100%;
    animation: float 4s ease-in-out infinite;
}

/* Flotación general */
@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-6px); }
    100% { transform: translateY(0px); }
}

/* Parpadeo de Ojos Digitales */
.avatar-eyes {
    transform-origin: center;
}

.eye-left, .eye-right {
    transform-origin: 43px 50px;
    animation: eyeBlink 5s infinite;
}

.eye-right {
    transform-origin: 57px 50px;
}

@keyframes eyeBlink {
    0%, 92%, 100% {
        transform: scaleY(1);
    }
    96% {
        transform: scaleY(0.1);
    }
}

/* Luz parpadeante de antena */
.antenna-light {
    animation: pulseAntenna 1.5s infinite alternate;
}

@keyframes pulseAntenna {
    0% { fill: #00E5FF; filter: drop-shadow(0 0 1px #00E5FF); }
    100% { fill: #FF3B30; filter: drop-shadow(0 0 4px #FF3B30); }
}

/* Badge de Notificación */
.notification-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: #FF3B30;
    color: #FFF;
    border: 2px solid #FFF;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(255, 59, 48, 0.4);
    animation: pulseBadge 2s infinite;
}

@keyframes pulseBadge {
    0% { transform: scale(1); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
}

/* VENTANA DE CHAT */
.chat-widget {
    width: 360px;
    height: 520px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    backdrop-filter: blur(12px);
    animation: chatOpen 0.35s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    transform-origin: bottom right;
}

@keyframes chatOpen {
    0% { transform: scale(0.6) translateY(40px); opacity: 0; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
}

/* Cabecera del Chat */
.chat-header {
    background-color: var(--primary);
    color: #FFF;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.chat-avatar-mini {
    display: flex;
    align-items: center;
}

.chat-title-info {
    flex-grow: 1;
    margin-left: 12px;
}

.chat-title-info h4 {
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

.online-indicator {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
}

.online-indicator .dot {
    width: 6px;
    height: 6px;
    background-color: #48BB78;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 6px #48BB78;
    animation: blinkIndicator 1.5s infinite alternate;
}

@keyframes blinkIndicator {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
}

.chat-close-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: var(--transition-fast);
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chat-close-btn:hover {
    color: #FFF;
    background: rgba(255,255,255,0.1);
}

/* Área de Mensajes */
.chat-messages-container {
    flex-grow: 1;
    padding: 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background-image: radial-gradient(rgba(12, 35, 64, 0.02) 1px, transparent 0);
    background-size: 16px 16px;
}

/* Estilo para Scroll del Chat */
.chat-messages-container::-webkit-scrollbar {
    width: 6px;
}

.chat-messages-container::-webkit-scrollbar-track {
    background: transparent;
}

.chat-messages-container::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 10px;
}

.chat-messages-container::-webkit-scrollbar-thumb:hover {
    background-color: rgba(0, 0, 0, 0.2);
}

/* Mensajes individuales */
.message {
    display: flex;
    flex-direction: column;
    max-width: 82%;
}

.message.assistant {
    align-self: flex-start;
}

.message.user {
    align-self: flex-end;
}

.message-bubble {
    padding: 12px 16px;
    border-radius: var(--border-radius-md);
    font-size: 13.5px;
    line-height: 1.5;
    position: relative;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.message.assistant .message-bubble {
    background-color: #FFF;
    color: var(--text-main);
    border: 1px solid var(--border-color);
    border-top-left-radius: 4px;
}

.message.user .message-bubble {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: #FFF;
    border-top-right-radius: 4px;
}

.message-time {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 4px;
    align-self: flex-end;
}

.message.assistant .message-time {
    align-self: flex-start;
}

/* Enlaces o botones interactivos dentro del chat */
.chat-action-box {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.btn-chat-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    color: #FFF;
    background-color: var(--primary-light);
    border: none;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition-fast);
}

.btn-chat-action:hover {
    background-color: var(--secondary-hover);
    color: var(--primary);
}

.btn-chat-action.secondary-btn {
    background-color: #FFF;
    border: 1.5px solid var(--primary-light);
    color: var(--primary-light);
}

.btn-chat-action.secondary-btn:hover {
    background-color: var(--primary-glow);
    color: var(--primary);
}

/* Sugerencias en Chat */
.chat-suggestions {
    margin-top: 4px;
    padding: 10px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.suggestion-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.suggestions-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.suggest-btn {
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    background: #FFF;
    color: var(--primary-light);
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    border-radius: 50px;
    cursor: pointer;
    transition: var(--transition-fast);
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

.suggest-btn:hover {
    background-color: var(--primary-glow);
    border-color: var(--primary);
    color: var(--primary);
}

/* Indicador de Escritura */
.typing-indicator {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 4px;
    background: #FFF;
    border: 1px solid var(--border-color);
    padding: 10px 14px;
    border-radius: var(--border-radius-md);
    border-top-left-radius: 4px;
    font-size: 12px;
    color: var(--text-muted);
    margin: 0 20px 10px;
    box-shadow: var(--shadow-sm);
}

.typing-indicator .dot {
    width: 6px;
    height: 6px;
    background-color: var(--text-muted);
    border-radius: 50%;
    animation: typingPulse 1.2s infinite ease-in-out;
}

.typing-indicator .dot:nth-child(2) {
    animation-delay: 0.2s;
}

.typing-indicator .dot:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes typingPulse {
    0%, 100% { transform: scale(0.6); opacity: 0.4; }
    50% { transform: scale(1.1); opacity: 1; }
}

/* Input del Chat */
.chat-input-area {
    padding: 12px 16px;
    background: #FFF;
    border-top: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 8px;
}

.chat-input-area input {
    flex-grow: 1;
    border: 1.5px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 10px 14px;
    font-size: 13.5px;
    font-family: inherit;
    color: var(--text-main);
    transition: var(--transition-fast);
}

.chat-input-area input:focus {
    outline: none;
    border-color: var(--primary);
}

.send-btn {
    background-color: var(--primary);
    color: #FFF;
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
}

.send-btn:hover {
    background-color: var(--primary-light);
    transform: scale(1.05);
}

.send-btn:active {
    transform: scale(0.95);
}

.send-btn span {
    font-size: 18px;
}

/* Responsividad para móviles del Widget de Chat */
@media(max-width: 480px) {
    .app-container {
        padding: 16px 12px;
    }

    .logo-unes-img {
        height: 42px;
    }

    .logo-text h1 {
        font-size: 22px;
    }

    .logo-text p {
        font-size: 12px;
    }

    .articles-grid {
        gap: 16px;
    }

    .article-card {
        padding: 16px;
    }

    .modal-card {
        margin: 10px;
        border-radius: var(--border-radius-md);
    }

    .modal-header {
        padding: 16px 20px;
    }

    .modal-body {
        padding: 16px 20px;
        max-height: 55vh;
    }

    .assistant-container {
        bottom: 16px;
        right: 16px;
    }
    
    .chat-widget {
        width: calc(100vw - 32px);
        height: calc(100vh - 120px);
        max-height: 480px;
    }
    
    .avatar-bubble {
        width: calc(100vw - 64px);
    }
}
