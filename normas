    sad: "M46 56 Q50 53 54 56",         // Curva hacia abajo (Disculpa)
    talking: "M48 54 A2 2 0 1 0 52 54 A2 2 0 1 0 48 54" // Círculo pequeño (Hablando)
};

// 3. Inicialización
document.addEventListener("DOMContentLoaded", () => {
