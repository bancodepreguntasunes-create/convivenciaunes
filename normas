});

// Actualizar hora en el primer mensaje de bienvenida
function updateWelcomeTime() {
    const welcomeTimeSpan = document.getElementById("welcome-time");
    if (welcomeTimeSpan) {
        welcomeTimeSpan.textContent = formatTime(new Date());
    }
}

// Formatear hora amigable (hh:mm AM/PM)
function formatTime(date) {
    let hours = date.getHours();
    let minutes = date.getMinutes();
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12;
    hours = hours ? hours : 12; // el 0 debe ser 12
    minutes = minutes < 10 ? '0' + minutes : minutes;
    return `${hours}:${minutes} ${ampm}`;
}

// 4. Renderizado de Artículos en la Grilla
function renderArticles() {
    articlesGrid.innerHTML = "";

    // Filtrar artículos
    const filtered = NORMAS_UNES.filter(art => {
        const matchesCategory = currentCategory === "all" || art.category === currentCategory;
        
        // Búsqueda por texto (Normalizar y quitar acentos)
        const normalizedQuery = normalizeText(searchQuery);
        const matchesSearch = normalizedQuery === "" || 
            normalizeText(art.title).includes(normalizedQuery) ||
            normalizeText(art.content).includes(normalizedQuery) ||
            art.keywords.some(kw => normalizeText(kw).includes(normalizedQuery));

        return matchesCategory && matchesSearch;
    });

    // Actualizar Contador
    articlesCount.textContent = `${filtered.length} ${filtered.length === 1 ? 'artículo' : 'artículos'}`;

    if (filtered.length === 0) {
        articlesGrid.innerHTML = `
            <div class="empty-state">
                <span class="material-symbols-outlined">search_off</span>
                <h3>No se encontraron resultados</h3>
                <p>No encontramos artículos que coincidan con "${searchQuery}". Intenta buscando otras palabras clave o pregúntale a nuestro asistente virtual.</p>
                <button class="btn btn-primary" id="reset-search-btn">Restablecer filtros</button>
            </div>
        `;
        document.getElementById("reset-search-btn")?.addEventListener("click", () => {
            searchInput.value = "";
            searchQuery = "";
            clearSearchBtn.style.display = "none";
            currentCategory = "all";
            updateActiveTab();
            renderArticles();
        });
        return;
    }

    filtered.forEach(art => {
        const card = document.createElement("div");
        card.className = `article-card cat-${art.category}`;
        card.innerHTML = `
            <div class="card-top">
                <div class="card-meta">
                    <span class="category-tag">${art.categoryLabel}</span>
                    <span class="material-symbols-outlined article-icon">${art.icon}</span>
                </div>
                <h3>${art.title}</h3>
                <p>${art.preview}</p>
            </div>
            <div class="card-bottom">
                <button class="btn-link read-more-btn" data-id="${art.id}">
                    Leer más <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </div>
        `;
        articlesGrid.appendChild(card);
    });

    // Agregar eventos a botones de Leer Más
    document.querySelectorAll(".read-more-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
            const artId = parseInt(e.currentTarget.getAttribute("data-id"));
            openModal(artId);
        });
    });
}

// Normalizar texto en español (eliminar acentos y poner en minúsculas)
function normalizeText(text) {
    return text
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "") // Eliminar acentos
        .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?¿¡]/g, ""); // Eliminar signos de puntuación
}

// 5. Lógica de Navegación por Categorías
function updateActiveTab() {
    document.querySelectorAll(".tab-btn").forEach(btn => {
        if (btn.getAttribute("data-category") === currentCategory) {
            btn.classList.add("active");
        } else {
            btn.classList.remove("active");
        }
    });
}

// 6. Lógica de Modales
function openModal(id) {
    const art = NORMAS_UNES.find(a => a.id === id);
    if (!art) return;

    selectedArticleForAsk = art;
    modalCategory.textContent = art.categoryLabel;
    
    // Cambiar clases según categoría
    modalCategory.className = "modal-category-tag";
    if (art.category === "principios") modalCategory.style.backgroundColor = "#4299E1";
    if (art.category === "derechos-deberes") modalCategory.style.backgroundColor = "#48BB78";
    if (art.category === "disciplina") modalCategory.style.backgroundColor = "#F56565";

    modalTitle.textContent = art.title;
    modalContent.innerHTML = art.content.replace(/\n/g, "<br>");
    
    // Llenar keywords
    modalKeywords.innerHTML = "";
    art.keywords.slice(0, 7).forEach(kw => {
        const tag = document.createElement("span");
        tag.className = "keyword-tag";
        tag.textContent = kw;
        modalKeywords.appendChild(tag);
    });

    articleModal.style.display = "flex";
}

function closeModal() {
    articleModal.style.display = "none";
    selectedArticleForAsk = null;
}

// 7. Event Listeners Principales
function setupEventListeners() {
    // Escucha de buscador
    searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value;
        if (searchQuery.trim() !== "") {
            clearSearchBtn.style.display = "flex";
        } else {
            clearSearchBtn.style.display = "none";
        }
        renderArticles();
    });

    // Limpiar buscador
    clearSearchBtn.addEventListener("click", () => {
        searchInput.value = "";
        searchQuery = "";
        clearSearchBtn.style.display = "none";
        renderArticles();
    });

    // Escucha de pestañas de categoría
    categoryTabs.addEventListener("click", (e) => {
        if (e.target.classList.contains("tab-btn")) {
            currentCategory = e.target.getAttribute("data-category");
            updateActiveTab();
            renderArticles();
        }
    });

    // Eventos de Modal
    closeModalBtn.addEventListener("click", closeModal);
    articleModal.addEventListener("click", (e) => {
        if (e.target === articleModal) closeModal();
    });

    // Botón preguntar dentro del modal
    modalAskBtn.addEventListener("click", () => {
        if (selectedArticleForAsk) {
            const question = `Háblame sobre el ${selectedArticleForAsk.title}`;
            closeModal();
            openChat();
            handleUserMessage(question);
        }
    });

    // --- EVENTOS DEL CHAT ASSISTANT ---
    
    // Al hacer clic en el avatar flotante
    avatarTrigger.addEventListener("click", () => {
        if (chatWidget.style.display === "none") {
            openChat();
        } else {
            closeChat();
        }
    });

    // Al hacer clic en el botón cerrar del chat
    closeChatBtn.addEventListener("click", closeChat);

    // Enviar formulario de chat
    chatForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const text = chatInput.value.trim();
        if (text === "") return;
        
        chatInput.value = "";
        handleUserMessage(text);
    });

    // Clic en sugerencias de chat
    chatMessages.addEventListener("click", (e) => {
        if (e.target.classList.contains("suggest-btn")) {
            const query = e.target.getAttribute("data-query");
            handleUserMessage(query);
        }
    });
}

// 8. Lógica del Chat Interactivo del Asistente

function openChat() {
    chatWidget.style.display = "flex";
    avatarBubble.style.display = "none"; // Ocultar globo inicial
    notifBadge.style.display = "none"; // Quitar badge de notificación
    hasInteractedWithChat = true;
    chatInput.focus();
    
    // Cambiar expresión a sonrisa
    setAvatarMouth("smile");
}

function closeChat() {
    chatWidget.style.display = "none";
}

// Cambiar la boca del SVG de Unesito
function setAvatarMouth(expressionName) {
    if (avatarMouth && AVATAR_EXPRESSIONS[expressionName]) {
        avatarMouth.setAttribute("d", AVATAR_EXPRESSIONS[expressionName]);
    }
}

// Play notification sound safely
function playNotificationSound() {
    notifSound.play().catch(e => {
        // Ignorar errores de autoplay del navegador si el usuario no ha interactuado
        console.log("Sonido omitido debido a políticas de autoplay");
    });
}

// Enviar el mensaje del usuario al chat
function handleUserMessage(messageText) {
    // 1. Ocultar chips de sugerencias previos
    const currentSuggestions = document.getElementById("chat-suggestions");
    if (currentSuggestions) {
        currentSuggestions.remove();
    }

    // 2. Agregar burbuja de usuario
    appendMessage(messageText, "user");

    // 3. Mostrar indicador de escritura y cambiar expresión del avatar a "pensando"
    showTypingIndicator(true);
    setAvatarMouth("thinking");

    // 4. Procesar respuesta con retraso artificial
    setTimeout(() => {
        const response = generateBotResponse(messageText);
        showTypingIndicator(false);
        
        // Agregar respuesta del bot
        appendMessage(response.text, "assistant", response.action);
        
        // Cambiar expresión de Unesito según el resultado
        setAvatarMouth(response.mood);
        
        // Reproducir sonido
        playNotificationSound();
    }, 1200);
}

// Agregar burbuja de mensaje al DOM
function appendMessage(text, sender, action = null) {
    const msgDiv = document.createElement("div");
    msgDiv.className = `message ${sender}`;
    
    // Formatear texto para admitir saltos de línea e hipervínculos simples
    let formattedText = text.replace(/\n/g, "<br>");
    
    // Crear el cuerpo de la burbuja
    let bubbleContent = `<div class="message-bubble">${formattedText}`;
    
    // Si hay una acción adjunta (soportando los distintos tipos)
    if (action) {
        if (action.type === "fallback") {
            bubbleContent += `
                <div class="chat-action-box">
                    <a href="${action.formLink}" target="_blank" class="btn-chat-action">
                        <span class="material-symbols-outlined">assignment</span> Llenar Formulario de Asesoría
                    </a>
                    <a href="${action.emailLink}" class="btn-chat-action secondary-btn">
                        <span class="material-symbols-outlined">mail</span> Enviar Correo Directo
                    </a>
                </div>
            `;
        } else if (action.type === "article_link") {
            bubbleContent += `
                <div class="chat-action-box">
                    <button class="btn-chat-action secondary-btn read-article-chat-btn" data-id="${action.articleId}">
                        <span class="material-symbols-outlined">menu_book</span> Leer Artículo Completo
                    </button>
                </div>
            `;
        }
    }
    
    bubbleContent += `</div><span class="message-time">${formatTime(new Date())}</span>`;
    msgDiv.innerHTML = bubbleContent;
    
    chatMessages.appendChild(msgDiv);
    
    // Auto-scroll al final del chat
    chatMessages.scrollTop = chatMessages.scrollHeight;

    // Agregar evento si es un enlace de artículo dentro del chat
    const artLinkBtn = msgDiv.querySelector(".read-article-chat-btn");
    if (artLinkBtn) {
        artLinkBtn.addEventListener("click", (e) => {
            const id = parseInt(e.currentTarget.getAttribute("data-id"));
            openModal(id);
        });
    }
}

// Controlar visualización del indicador de escritura
function showTypingIndicator(show) {
    if (show) {
        typingIndicator.style.display = "flex";
        chatMessages.appendChild(typingIndicator);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    } else {
        typingIndicator.style.display = "none";
    }
}

// 9. Motor Inteligente de Procesamiento de Respuestas (FAQ + Semántica de palabras clave)
function generateBotResponse(userQuery) {
    const cleanQuery = normalizeText(userQuery);

    // Respuestas a saludos comunes y cortesías
    if (matchesAny(cleanQuery, ["hola", "buenas", "buenos dias", "buenas tardes", "saludos", "unesito", "alo", "hey"])) {
        return {
            text: "¡Hola! Qué gusto saludarte. Soy Unesito. 👮‍♂️👋\n\nEstoy aquí para responder todas tus preguntas sobre las Normas de Convivencia y Régimen Disciplinario de la UNES (Acuerdo N° 0000692 de Julio de 2024).\n\n¿Tienes alguna duda sobre uniformes, faltas leves, graves, asistencia o tus derechos? ¡Dime!",
            mood: "smile"
        };
    }

    if (matchesAny(cleanQuery, ["gracias", "agradecido", "excelente", "buenisimo", "perfecto", "ok", "entendido", "chao", "adios"])) {
        return {
            text: "¡A la orden siempre! Recuerda que conocer y cumplir nuestras normas fortalece nuestra disciplina y obediencia voluntaria en la UNES. ¡Mucho éxito en tu formación! 🌟📚",
            mood: "smile"
        };
    }

    if (matchesAny(cleanQuery, ["quien eres", "que haces", "cual es tu funcion", "ayudame", "ayuda"])) {
        return {
            text: "Soy Unesito, el asistente del reglamento estudiantil UNES. 🤖 de la Reforma N° 0000692.\n\nMi propósito es ayudarte a entender de manera fácil las normas. Pregúntame sobre:\n• *¿Cuáles son las faltas leves y graves?*\n• *¿Qué pasa si falto un día?*\n• *¿Cuáles son mis derechos?*",
            mood: "smile"
        };
    }

    // Análisis de búsqueda por palabras clave en los artículos
    let bestArticle = null;
    let maxMatches = 0;
    
    // Dividir la consulta limpia en tokens o palabras significativas
    const queryWords = cleanQuery.split(/\s+/).filter(w => w.length > 2);

    NORMAS_UNES.forEach(art => {
        let matches = 0;
        
        // 1. Coincidencia directa de palabras clave en el array de keywords
        art.keywords.forEach(kw => {
            const cleanKw = normalizeText(kw);
            if (cleanQuery.includes(cleanKw)) {
                matches += 2.2; // Mayor peso
            }
        });

        // 2. Coincidencia de palabras individuales en el contenido/título
        queryWords.forEach(word => {
            if (normalizeText(art.title).includes(word)) {
                matches += 1.5;
            }
            if (normalizeText(art.content).includes(word)) {
                matches += 0.5;
            }
        });

        // Guardar el artículo con mayor puntuación
        if (matches > maxMatches) {
            maxMatches = matches;
            bestArticle = art;
        }
    });

    // Si encontramos una coincidencia relevante
    if (bestArticle && maxMatches >= 1.5) {
        let responseText = "";
        
        // Personalizar la respuesta según el tipo de artículo
        if (bestArticle.id === 90) { // Faltas leves
            responseText = "Respecto a las **Faltas Leves** (**Artículo 90**), restan **15 puntos de demérito**. Son comportamientos menores que perturban la convivencia, tales como:\n• Tener retardos injustificados.\n• Ingerir alimentos en las aulas de clase.\n• No prestar atención a los docentes.\n• Descuido en la limpieza y orden del lugar.\n• Cambiarse el uniforme en lugares no autorizados.";
        } else if (bestArticle.id === 91) { // Faltas graves
            responseText = "Las **Faltas Graves** (**Artículo 91**) restan **30 puntos de demérito**. Incluyen comportamientos significativos:\n• Inasistencias injustificadas a clases.\n• Usar teléfonos celulares, música o audífonos en horas académicas sin autorización.\n• Incumplir con el correcto uso del uniforme.\n• Negligencia en acatar órdenes de tus superiores.\n• Ofender o provocar a autoridades o compañeros.";
        } else if (bestArticle.id === 92) { // Faltas gravísimas
            responseText = "Las **Faltas Gravísimas** (**Artículo 92**) atentan contra los DDHH o leyes penales. Conllevan **Consejo Disciplinario y Retiro Inmediato (Expulsión)**. Incluyen:\n• Agredir físicamente a compañeros o superiores.\n• Portar armas de fuego, armas blancas o explosivos.\n• Presentarse bajo efectos del alcohol o drogas.\n• Fraude académico (copiarse o cometer plagio en exámenes).\n• Realizar actos lascivos/sexuales en el recinto.";
        } else if (bestArticle.id === 18) { // Derechos
            responseText = "Tus **Derechos** están en el **Artículo 18** e incluyen:\n• Recibir un trato digno, respetuoso y sin discriminación.\n• Asistencia médica, odontológica, psicológica y jurídica.\n• Derecho al debido proceso y legítima defensa.\n• Recibir la dotación de uniformes y materiales de estudio.";
        } else if (bestArticle.id === 19) { // Deberes
            responseText = "Tus **Deberes** básicos se regulan en el **Artículo 19** e incluyen:\n• Responder con voz alta y firme **'ordene'** ante un superior.\n• Mantener una distancia de cuatro (4) pasos al hablar con autoridades.\n• No usar celulares ni audífonos en clase (causan distracción).\n• Prohibido estar tomados de la mano, abrazados o besándose dentro de la universidad.";
        } else if (bestArticle.id === 20 || bestArticle.id === 22) { // Asistencia
            responseText = "Sobre la **Asistencia** (**Artículos 20 y 22**):\n• Es obligatoria. Pasar lista y no estar se considera inasistencia.\n• En caso de faltar, debes entregar el justificativo firmado ante el Director del Centro en un plazo máximo de **tres (3) días hábiles**.";
        } else if (bestArticle.id === 94) { // Sanciones leves
            responseText = "Las **Sanciones por Faltas Leves** (**Artículo 94**) son programas cortos de supervisión:\n• Amonestación verbal.\n• Práctica intensiva (física/técnica) de media hora.\n• Trabajo escrito con exposición reflexiva ante el aula.\n• Restricción del permiso ordinario de salida hasta 15 días.";
        } else if (bestArticle.id === 95) { // Sanciones graves
            responseText = "Las **Sanciones por Faltas Graves** (**Artículo 95**) consisten en:\n• Amonestación escrita en tu expediente.\n• Reentrenamiento físico/técnico de 1 hora.\n• Labores de mantenimiento de infraestructura en el centro.\n• Suspensión del permiso de salida hasta por un mes.";
        } else {
            responseText = `Encontré información relevante en el **${bestArticle.title}**:\n\n"${bestArticle.preview}"`;
        }

        return {
            text: responseText + "\n\n¿Te gustaría que te muestre el artículo completo en pantalla?",
            mood: "smile",
            action: {
                type: "article_link",
                articleId: bestArticle.id
            }
        };
    }

    // 10. FALLBACK: Si no se encuentra en las normas, se ofrece el formulario de asesoría y el correo
    const supportEmail = "asesoriaestudianteunes@gmail.com";
    const googleFormLink = "https://forms.gle/9VAbMmq7XqdjMg6U6";
    const mailtoSubject = encodeURIComponent("Consulta sobre Normas de Convivencia UNES");
    const mailtoBody = encodeURIComponent("Estimados Asesores Estudiantiles,\n\nTengo la siguiente consulta que no encontré en el reglamento de convivencia de la UNES:\n\n[Ingresa tu duda aquí]\n\nAtentamente,\n[Nombre Completo]\n[C.I. / PNF / Centro de Formación]");
    const mailtoLink = `mailto:${supportEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;

    return {
        text: `No encontré una respuesta específica sobre eso en las Normas de Convivencia vigentes de la UNES (Acuerdo N° 0000692). 😕\n\nPero no te preocupes, puedes registrar tu duda en nuestro Formulario Oficial de Asesorías, o escribirnos directamente a nuestro correo de contacto para resolver tus dudas.`,
        mood: "sad", // Expresión apenada
        action: {
            type: "fallback",
            formLink: googleFormLink,
            emailLink: mailtoLink
        }
    };
}

// Función auxiliar para comparar palabras clave
function matchesAny(text, list) {
    return list.some(item => text.includes(item));
}

